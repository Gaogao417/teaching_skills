# Math Homework Pipeline / Artifact intermediate folders
# Keep deliverables (*.md, *.tex, *.pdf) under artifacts/
# but ignore transient compilation, diagram generation, and image preview files
artifacts/**/build/
artifacts/**/diagram/
artifacts/**/preview/
# Review UI catalog-version files are rebuildable cache-invalidation markers
# (docs/review-server-performance-redesign.md §5.3). Ignored to avoid merge conflicts.
artifacts/题库/**/.catalog-version
/build/diagram-preview/
/build/qa-preview/
/build/
/tmp/
/pets/

# Local renderer output dumps (regenerated; not shared)
/output/

# Question-bank ingestion derived artifacts (live alongside source docs)
# source.docx and original *.docx stay tracked; extraction output is regenerated.
documents/**/word/
documents/**/word_extract/
documents/**/word_test/
documents/**/word_source/
documents/**/qa/
