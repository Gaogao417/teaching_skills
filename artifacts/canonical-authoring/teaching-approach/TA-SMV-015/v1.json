    {
      "expected_student_reasoning": "学生能写出两种等价表达并选用平方形式。",
      "intent": "定义回忆",
      "narration": "比例中项定义：$b^2=ac$（即 $\\frac{a}{b}=\\frac{b}{c}$），本题即求满足 $b^2=4\\times 9$ 的线段 $b$。",
      "skill_ids": [
        "SKILL-SMV-001"
      ],
      "step_id": "S1"
    },
    {
      "expected_student_reasoning": "学生能正确完成乘法 4×9=36。",
      "intent": "代入计算",
      "narration": "代入 $a=4$、$c=9$，$b^2=36$。",
      "skill_ids": [
        "SKILL-SMV-007"
      ],
      "step_id": "S2"
    },
    {
      "expected_student_reasoning": "学生能说明为什么开方后只取正值（线段长非负且非零）。",
      "intent": "开方取正值",
      "narration": "$b=\\sqrt{36}$，线段长度取正值，得比例中项为 $6$ 厘米。",
      "skill_ids": [
        "SKILL-SMV-007"
      ],
      "step_id": "S3"
    }
  ],
  "title": "比例中项定义性计算",
