{
  "$defs": {
    "PageEvidence": {
      "additionalProperties": false,
      "description": "Whole-page evidence. Typical for DOCX rendered pages.",
      "properties": {
        "kind": {
          "const": "page",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "source",
        "page_number"
      ],
      "title": "PageEvidence",
      "type": "object"
    },
    "PaperMeta": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "grade": {
          "minLength": 1,
          "title": "Grade",
          "type": "string"
        },
        "subject": {
          "default": "数学",
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "source_archive": {
          "minLength": 1,
          "title": "Source Archive",
          "type": "string"
        },
        "question_bank": {
          "default": "../../question-bank.yaml",
          "minLength": 1,
          "title": "Question Bank",
          "type": "string"
        },
        "duration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        }
      },
      "required": [
        "id",
        "title",
        "grade",
        "source_archive"
      ],
      "title": "PaperMeta",
      "type": "object"
    },
    "Provider": {
      "additionalProperties": false,
      "description": "Who produced a given bundle / attribution. Provenance, not authority.",
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "vision_api",
            "ocr",
            "docx_structure",
            "detection_model",
            "manual"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "Provider",
      "type": "object"
    },
    "QuestionContent": {
      "additionalProperties": false,
      "description": "The transcribed body of one question.\n\nThe assembler copies these fields verbatim; it never summarizes, merges, or\nre-splits ``solution_steps``.",
      "properties": {
        "stem_latex": {
          "minLength": 1,
          "title": "Stem Latex",
          "type": "string"
        },
        "choices": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        },
        "answer": {
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "clue": {
          "minLength": 1,
          "title": "Clue",
          "type": "string"
        },
        "solution_steps": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Solution Steps",
          "type": "array"
        },
        "solution_notes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Solution Notes",
          "type": "array"
        }
      },
      "required": [
        "stem_latex",
        "answer",
        "clue"
      ],
      "title": "QuestionContent",
      "type": "object"
    },
    "QuestionEvidence": {
      "additionalProperties": false,
      "description": "Evidence split by role within a single question.",
      "properties": {
        "question": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/PageEvidence"
              },
              {
                "$ref": "#/$defs/RegionEvidence"
              }
            ]
          },
          "minItems": 1,
          "title": "Question",
          "type": "array"
        },
        "solution": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/PageEvidence"
              },
              {
                "$ref": "#/$defs/RegionEvidence"
              }
            ]
          },
          "minItems": 1,
          "title": "Solution",
          "type": "array"
        },
        "solution_start_anchor": {
          "minLength": 1,
          "title": "Solution Start Anchor",
          "type": "string"
        },
        "solution_end_anchor": {
          "minLength": 1,
          "title": "Solution End Anchor",
          "type": "string"
        }
      },
      "required": [
        "question",
        "solution",
        "solution_start_anchor",
        "solution_end_anchor"
      ],
      "title": "QuestionEvidence",
      "type": "object"
    },
    "RegionEvidence": {
      "additionalProperties": false,
      "description": "Region evidence. Typical for PDF / scanned pages with a crop box.",
      "properties": {
        "kind": {
          "const": "region",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "box_px": {
          "items": {
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Box Px",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "source",
        "page_number",
        "box_px"
      ],
      "title": "RegionEvidence",
      "type": "object"
    },
    "TranscriptionQuestion": {
      "additionalProperties": false,
      "description": "One question in a :class:`QuestionTranscriptionBundle`.",
      "properties": {
        "question_ref": {
          "pattern": "^\\d{1,3}(-[A-Za-z0-9]+)?$",
          "title": "Question Ref",
          "type": "string"
        },
        "question_number": {
          "minimum": 1,
          "title": "Question Number",
          "type": "integer"
        },
        "question_type": {
          "enum": [
            "choice",
            "fillin",
            "problem",
            "short_answer"
          ],
          "title": "Question Type",
          "type": "string"
        },
        "points": {
          "minimum": 0,
          "title": "Points",
          "type": "integer"
        },
        "content": {
          "$ref": "#/$defs/QuestionContent"
        },
        "evidence": {
          "$ref": "#/$defs/QuestionEvidence"
        }
      },
      "required": [
        "question_ref",
        "question_number",
        "question_type",
        "points",
        "content",
        "evidence"
      ],
      "title": "TranscriptionQuestion",
      "type": "object"
    },
    "TranscriptionSection": {
      "additionalProperties": false,
      "properties": {
        "section_ref": {
          "minLength": 1,
          "title": "Section Ref",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/TranscriptionQuestion"
          },
          "minItems": 1,
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "section_ref",
        "title",
        "questions"
      ],
      "title": "TranscriptionSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema ``math_question_transcription/v1``.\n\nOne paper's transcribed text + evidence. ``sections[].questions[]`` order is\nthe final paper order; the assembler emits ``Q001``, ``Q002`` in that order.",
  "properties": {
    "schema": {
      "const": "math_question_transcription/v1",
      "title": "Schema",
      "type": "string"
    },
    "paper": {
      "$ref": "#/$defs/PaperMeta"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/TranscriptionSection"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    },
    "provider": {
      "$ref": "#/$defs/Provider"
    }
  },
  "required": [
    "schema",
    "paper",
    "sections",
    "provider"
  ],
  "title": "QuestionTranscriptionBundle",
  "type": "object"
}
